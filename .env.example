# 환경변수 예시 파일입니다. 값을 채운 사본을 .env.local 로 만들어 쓰고, 실제 값은 커밋하지 마세요.
# 현재 앱(화면)은 환경변수 없이 동작합니다. 아래 항목은 향후 연동용입니다.

# 향후 Oracle DB 저장 기능용 (README "향후 Oracle DB 저장을 붙일 자리" 참고)
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
# Oracle Wallet 압축을 푼 폴더 경로 (Wallet 파일 자체는 저장소에 넣지 않음)
TNS_ADMIN=
ORACLE_WALLET_PASSWORD=
